rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "BUrningSOUlofDarkness@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager']
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVerifiedCarrier() {
      return isAuthenticated() && getUserData().isVerifiedCarrier == true;
    }

    // ===============================================================
    // Validation Functions
    // ===============================================================
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 &&
             data.displayName is string &&
             data.email is string &&
             data.role in ['user', 'manager', 'admin'] &&
             data.isVerifiedCarrier is bool &&
             (!('photoURL' in data) || data.photoURL is string);
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.description is string && data.description.size() > 0 &&
             data.createdBy is string && data.createdBy.size() > 0 &&
             data.status in ['open', 'assigned', 'completed', 'cancelled'] &&
             data.reactionCount is number && data.reactionCount >= 0 &&
             data.createdAt is timestamp;
    }

    function isValidApplication(data) {
      return data.taskId is string && data.taskId.size() > 0 &&
             data.userId is string && data.userId.size() > 0 &&
             data.status in ['pending', 'accepted', 'rejected'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    // ─── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile; admins read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile (non-admin role unless bootstrapped)
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) &&
                    ((request.resource.data.role != 'admin') || isAdmin());
                    
      // Users can update their own non-sensitive fields; admins can update anything
      allow update: if isAuthenticated() && (
                      // Self-update: cannot change role, isVerifiedCarrier, or uid
                      (isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'isVerifiedCarrier', 'createdAt'])) ||
                      isAdmin()
                    );
    }

    // ─── Tasks ─────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Anyone authenticated can read tasks (feed)
      allow read: if isAuthenticated();
      
      // Any authenticated user can create a task
      allow create: if isAuthenticated() && 
                    isValidTask(request.resource.data) &&
                    request.resource.data.createdBy == request.auth.uid &&
                    request.resource.data.status == 'open' &&
                    request.resource.data.reactionCount == 0;
                    
      // Task owner, managers, and admins can update tasks
      // Anyone can increment reactionCount
      allow update: if isAuthenticated() && (
                      // Reaction increment only (anyone can like)
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']) &&
                       request.resource.data.reactionCount == resource.data.reactionCount + 1) ||
                      // Owner can update their own task
                      (resource.data.createdBy == request.auth.uid) ||
                      // Manager or admin can update any task
                      isManagerOrAdmin()
                    );
    }

    // ─── Applications ──────────────────────────────────────────
    match /applications/{applicationId} {
      // Applicant, task owner, managers, and admins can read
      allow read: if isAuthenticated() && (
                    resource.data.userId == request.auth.uid ||
                    isManagerOrAdmin() ||
                    isAdmin()
                   );
                   
      // Only verified carriers can create applications
      allow create: if isAuthenticated() && 
                    isVerifiedCarrier() &&
                    isValidApplication(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
                    
      // Only task owner, managers, and admins can update applications (accept/reject)
      allow update: if isAuthenticated() && isValidApplication(request.resource.data) && (
                      isManagerOrAdmin() || isAdmin()
                    );
    }

    // ─── Follows (Prepared, not fully implemented) ─────────────
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
    }
  }
}
